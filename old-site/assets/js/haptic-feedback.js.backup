/**
 * ADVANCED HAPTIC FEEDBACK SYSTEM
 * Premium iOS-style haptic patterns
 */

(function() {
  'use strict';

  // Check if vibration is supported
  const supportsVibration = 'vibrate' in navigator;

  /**
   * Haptic Patterns Library
   */
  const PATTERNS = {
    // Light feedback
    light: [10],
    
    // Medium feedback
    medium: [20],
    
    // Heavy feedback
    heavy: [30],
    
    // Success pattern
    success: [10, 50, 10, 50, 10],
    
    // Error pattern
    error: [30, 100, 30],
    
    // Warning pattern
    warning: [15, 50, 15, 50, 15],
    
    // Selection change
    selection: [10],
    
    // Navigation
    navigation: [15],
    
    // Notification
    notification: [20, 100, 20],
    
    // Button press
    buttonPress: [12],
    
    // Toggle on
    toggleOn: [10, 30, 10],
    
    // Toggle off
    toggleOff: [10],
    
    // Swipe
    swipe: [8],
    
    // Impact
    impact: [25],
    
    // Peek (3D touch)
    peek: [5],
    
    // Pop (3D touch)
    pop: [15, 20, 15],
    
    // Celebration
    celebration: [30, 50, 30, 50, 30, 50, 30],
    
    // Heart/Like
    heart: [10, 30, 10],
    
    // Unlock
    unlock: [15, 50, 25],
    
    // Lock
    lock: [25, 50, 15]
  };

  /**
   * Play haptic pattern
   */
  const play = (patternName) => {
    if (!supportsVibration) return;
    
    const pattern = PATTERNS[patternName];
    if (!pattern) {
      console.warn(`Haptic pattern "${patternName}" not found`);
      return;
    }
    
    navigator.vibrate(pattern);
  };

  /**
   * Play custom pattern
   */
  const playCustom = (pattern) => {
    if (!supportsVibration) return;
    if (!Array.isArray(pattern)) {
      console.warn('Custom haptic pattern must be an array');
      return;
    }
    
    navigator.vibrate(pattern);
  };

  /**
   * Auto-apply haptics to common elements
   */
  const autoApplyHaptics = () => {
    // Buttons
    document.querySelectorAll('button, .btn').forEach(btn => {
      if (!btn.dataset.haptic) {
        btn.addEventListener('click', () => play('buttonPress'), { passive: true });
        btn.dataset.haptic = 'true';
      }
    });
    
    // Links
    document.querySelectorAll('a').forEach(link => {
      if (!link.dataset.haptic) {
        link.addEventListener('click', () => play('light'), { passive: true });
        link.dataset.haptic = 'true';
      }
    });
    
    // Form inputs
    document.querySelectorAll('input, select, textarea').forEach(input => {
      if (!input.dataset.haptic) {
        input.addEventListener('focus', () => play('selection'), { passive: true });
        input.dataset.haptic = 'true';
      }
    });
    
    // Checkboxes and radios
    document.querySelectorAll('input[type="checkbox"], input[type="radio"]').forEach(input => {
      input.addEventListener('change', () => {
        play(input.checked ? 'toggleOn' : 'toggleOff');
      }, { passive: true });
    });
    
    // Cards
    document.querySelectorAll('.card, .category-card, .bento-card').forEach(card => {
      if (!card.dataset.haptic) {
        card.addEventListener('click', () => play('medium'), { passive: true });
        card.dataset.haptic = 'true';
      }
    });
    
    // Navigation items
    document.querySelectorAll('.nav-link, .mobile-bottom-nav-item').forEach(navItem => {
      if (!navItem.dataset.haptic) {
        navItem.addEventListener('click', () => play('navigation'), { passive: true });
        navItem.dataset.haptic = 'true';
      }
    });
    
    // Dropdowns
    document.querySelectorAll('.dropdown-toggle, .mobile-dropdown-toggle').forEach(toggle => {
      if (!toggle.dataset.haptic) {
        toggle.addEventListener('click', () => play('medium'), { passive: true });
        toggle.dataset.haptic = 'true';
      }
    });
  };

  // Apply on load
  document.addEventListener('DOMContentLoaded', autoApplyHaptics);
  
  // Re-apply when new content is added (for dynamic content)
  const observer = new MutationObserver((mutations) => {
    let shouldReapply = false;
    
    mutations.forEach(mutation => {
      if (mutation.addedNodes.length > 0) {
        shouldReapply = true;
      }
    });
    
    if (shouldReapply) {
      setTimeout(autoApplyHaptics, 100);
    }
  });
  
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

  // Export for external use
  window.Haptics = {
    play,
    playCustom,
    patterns: PATTERNS,
    supported: supportsVibration
  };

})();

