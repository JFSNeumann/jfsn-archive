#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# archive — thin dispatcher for JFSN stewardship utilities.
#
#   archive verify            read-only integrity inspection
#   archive verify --full     also decode-check every image tier
#   archive verify --json     machine-readable output
#
# Each subcommand is a small, independent tool under scripts/. This wrapper
# only routes; it holds no logic of its own.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cmd="${1:-}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  verify)
    exec python3 "$HERE/scripts/verify.py" "$@"
    ;;
  ""|-h|--help|help)
    cat <<'USAGE'
archive — JFSN stewardship utilities

Usage:
  archive verify [--full] [--json] [--quiet]
      Read-only conservator's inspection: "Can this archive still be trusted?"
      Reports PASS / WARNING / FAIL per integrity category. Modifies nothing.

Exit codes:
  0  no integrity FAILURES (PASS or WARNING)
  1  one or more FAIL results
USAGE
    ;;
  *)
    echo "archive: unknown command '$cmd' (try: archive verify)" >&2
    exit 2
    ;;
esac
