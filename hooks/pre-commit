#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# .git/hooks/pre-commit — automated checks before each commit
#
# Runs automatically before `git commit`
# Prevents broken code from being committed
#
# Checks:
# 1. Navigation audit (audit-nav.sh)
# 2. If .html/.js changed but CSS not rebuilt
# 3. If any sw.js-precached asset (CSS or JS) changed but CACHE_V not bumped
#    — .htaccess sets a 1-month browser Expires header on JS/CSS with no
#    cache-busting filenames anywhere, so for files sw.js explicitly
#    precaches by name, CACHE_V is the only thing that forces a fresh
#    fetch (cache.addAll() bypasses HTTP cache per spec, CACHE_V change
#    is what triggers a fresh install). Originally CSS-only; extended
#    2026-06-23 after a JS-only fix to search.js sat invisible to this
#    check even though search.js is itself in sw.js's PRECACHE list.
#
# If any check fails:
#   • Commit is rejected (exit code 1)
#   • Error message explains what to fix
#   • User can run: git commit --no-verify (forces commit, not recommended)
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍  Running pre-commit checks..."
FAILED=0

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

# CHECK 1: Navigation audit
echo "   • Navigation audit..."
if ! bash scripts/audit-nav.sh > /tmp/audit.log 2>&1; then
  echo -e "${RED}✗ Navigation audit failed${NC}"
  cat /tmp/audit.log
  FAILED=1
else
  echo -e "${GREEN}✓ Navigation audit passed${NC}"
fi

# CHECK 2: If HTML/JS changed, CSS must be rebuilt AND the rebuild must be staged
# (rebuilds and diffs for real, rather than just checking whether site.min.css
# happens to be in the staged file list — a content-free HTML/JS edit that adds
# no new Tailwind classes legitimately produces zero CSS diff, and the old
# all-or-nothing check blocked that case even though there was nothing to stage)
HTML_JS_CHANGED=$(echo "$STAGED_FILES" | grep -E '\.(html|js)$' | wc -l || true)
CSS_CHANGED=$(echo "$STAGED_FILES" | grep 'site\.min\.css' | wc -l || true)

if [ "$HTML_JS_CHANGED" -gt 0 ]; then
  cp site.min.css /tmp/site.min.css.precommit-check 2>/dev/null || true
  npm run build:css > /tmp/build-css.log 2>&1 || true
  if diff -q site.min.css /tmp/site.min.css.precommit-check > /dev/null 2>&1; then
    echo -e "${GREEN}✓ CSS rebuilt (no changes — nothing to stage)${NC}"
  elif [ "$CSS_CHANGED" -gt 0 ]; then
    echo -e "${GREEN}✓ CSS rebuilt and staged${NC}"
  else
    echo -e "${YELLOW}⚠  CSS rebuild produced changes that aren't staged${NC}"
    echo "    Run: git add site.min.css && git commit again"
    FAILED=1
  fi
  rm -f /tmp/site.min.css.precommit-check
fi

# CHECK 3: If any sw.js-precached asset changed, CACHE_V must be bumped
# (must match auto-cache-bump.sh's PRECACHE_FILES list)
PRECACHE_FILES=(site.min.css search.js _shared/ui.css _shared/ui.js _shared/nav-active.js _shared/anime.min.js)
PRECACHE_CHANGED=0
for f in "${PRECACHE_FILES[@]}"; do
  if echo "$STAGED_FILES" | grep -qF "$f"; then
    PRECACHE_CHANGED=1
    break
  fi
done

if [ "$PRECACHE_CHANGED" -eq 1 ]; then
  CURRENT_CACHE_V=$(grep "const CACHE_V" sw.js | head -1 | sed "s/.*'\(.*\)'.*/\1/")
  HEAD_CACHE_V=$(git show HEAD:sw.js 2>/dev/null | grep "const CACHE_V" | head -1 | sed "s/.*'\(.*\)'.*/\1/" || echo "")
  if echo "$CURRENT_CACHE_V" | grep -q "^jfsn-[0-9]\{10\}$" && [ "$CURRENT_CACHE_V" != "$HEAD_CACHE_V" ]; then
    echo -e "${GREEN}✓ CACHE_V bumped${NC}"
  else
    echo -e "${RED}✗ CACHE_V not bumped after a precached asset changed${NC}"
    echo "    Run: bash scripts/auto-cache-bump.sh"
    echo "    Then: git add sw.js && git commit again"
    FAILED=1
  fi
fi

echo ""

if [ "$FAILED" -eq 1 ]; then
  echo -e "${RED}❌  Commit blocked — fix issues above${NC}"
  echo "    To skip (not recommended):  git commit --no-verify"
  exit 1
fi

echo -e "${GREEN}✅  All checks passed${NC}"
exit 0
