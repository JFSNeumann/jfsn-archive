# ============================================
# old-site/ — image sharing shim
# Artwork images are NOT stored here — they live
# in the root artworks/ folder and are served
# transparently via these rewrite rules.
# ============================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /old-site/

  # Serve artworks from the shared root artworks/ folder.
  # Only fires when the file doesn't exist locally (avoids loops).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^artworks/(.+\.avif)$ /artworks/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^artworks/(.+\.jpg)$ /artworks/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^artworks/(.+\.png)$ /artworks/$1 [L]
</IfModule>
